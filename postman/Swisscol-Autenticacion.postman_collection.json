  "item": [
    {
      "name": "Registro exitoso",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const respuesta = pm.response.json();\r",
              "\r",
              "pm.test(\"Estado HTTP 201\", function () {\r",
              "    pm.response.to.have.status(201);\r",
              "});\r",
              "\r",
              "pm.test(\"Registro exitoso\", function () {\r",
              "    pm.expect(respuesta.exito).to.eql(true);\r",
              "    pm.expect(respuesta.mensaje)\r",
              "        .to.eql(\"Usuario registrado correctamente.\");\r",
              "});\r",
              "\r",
              "pm.test(\"Devuelve los datos del nuevo usuario\", function () {\r",
              "    pm.expect(respuesta).to.have.property(\"usuarioId\");\r",
              "    pm.expect(respuesta.correo)\r",
              "        .to.eql(pm.variables.get(\"correo_prueba\"));\r",
              "    pm.expect(respuesta.rol).to.eql(\"CUSTOMER\");\r",
              "});\r",
              "\r",
              "pm.test(\"No expone la contraseña\", function () {\r",
              "    pm.expect(respuesta).to.not.have.property(\"password\");\r",
              "    pm.expect(respuesta).to.not.have.property(\"passwordHash\");\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        },
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const correoPrueba = `evidencia.${Date.now()}@swisscol.com`;\r",
              "\r",
              "pm.variables.set(\"correo_prueba\", correoPrueba);"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"nombre\": \"Usuario Evidencia\",\n    \"correo\": \"{{correo_prueba}}\",\n    \"password\": \"ClaveSegura123\",\n    \"confirmarPassword\": \"ClaveSegura123\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/auth/registro",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "auth",
            "registro"
          ]
        },
        "description": "This is a POST request, submitting data to an API via the request body. This request submits JSON data, and the data is reflected in the response.\n\nA successful POST request typically returns a `200 OK` or `201 Created` response code."
      },
      "response": []
    },
