        {
          "name": "Listar productos",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const respuesta = pm.response.json();",
                  "",
                  "pm.test(\"Estado HTTP 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Devuelve una lista\", function () {",
                  "    pm.expect(respuesta).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"La lista contiene productos\", function () {",
                  "    pm.expect(respuesta.length).to.be.above(0);",
                  "});",
                  "",
                  "pm.test(\"Respuesta en formato JSON\", function () {",
                  "    pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "        .to.include(\"application/json\");",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
