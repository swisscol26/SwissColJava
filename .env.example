# Referencia: Java lee variables del proceso, no carga este archivo automáticamente.
PORT=8080
SWISSCOL_BIND_ADDRESS=127.0.0.1
# Opcional en local; el Dockerfile configura /app/web en Render.
SWISSCOL_WEB_ROOT=
SWISSCOL_ALLOWED_ORIGINS=https://TU-DOMINIO
SWISSCOL_COOKIE_SECURE=true
SWISSCOL_DB_URL=jdbc:mysql://HOST-BD:3306/database_swisscol?sslMode=VERIFY_IDENTITY&serverTimezone=America/Bogota
SWISSCOL_DB_USER=swisscol_app
SWISSCOL_DB_PASSWORD=
SWISSCOL_NEQUI_NUMBER=
SWISSCOL_NEQUI_HOLDER=
SWISSCOL_MAIL_USER=
SWISSCOL_MAIL_PASSWORD=
